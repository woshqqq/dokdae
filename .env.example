# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 git에 커밋되지 않습니다(.gitignore의 .env*).
# 실제 비밀키를 이 파일(.env.example)에 넣지 마세요.

# ---------------------------------------------------------------
# 데이터 소스
#   mock     : 서버 메모리의 임시 데이터. 실제 인증·저장·정산이 아님(개발용)
#   supabase : 실제 Supabase Auth/DB
# 비워 두면 개발 서버(npm run dev)는 mock, 프로덕션(next build/start, Vercel)은 supabase 입니다.
# ---------------------------------------------------------------
DOKDAE_DATA_SOURCE=supabase

# ---------------------------------------------------------------
# Supabase — 대시보드 > Project Settings > API Keys
# ---------------------------------------------------------------
# 프로젝트 URL (브라우저에 노출되어도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# publishable key (sb_publishable_...) — 브라우저에 노출되어도 되는 값. 데이터는 RLS·RPC 권한으로 보호됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 이메일 확인 링크에 쓰는 사이트 주소. 배포 환경에서는 반드시 실제 도메인으로 설정하세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# 서버 전용 비밀값 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 예약 정리 Cron(/api/cron/maintenance)에서만 사용합니다. 쓰지 않으면 비워 두어도 앱은 동작합니다.
# ---------------------------------------------------------------
# ---------------------------------------------------------------
# 비회원 테스트 모드 (/test-login) — 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# DOKDAE_TEST_MODE=true 이고 DOKDAE_TEST_PASSWORD가 8자 이상일 때만 켜집니다. 끄려면 false로 바꾸거나 지우세요.
# 테스트 세션은 운영 DB를 쓰지 않고 서버 메모리의 임시 데이터만 씁니다.
# ---------------------------------------------------------------
DOKDAE_TEST_MODE=false
# 테스트하는 사람들에게 공유할 공통 비밀번호. 충분히 길고 추측하기 어렵게 정하세요(바꾸면 기존 테스트 세션이 모두 만료).
DOKDAE_TEST_PASSWORD=

# secret key (sb_secret_...) 또는 기존 service_role key
SUPABASE_SECRET_KEY=
# Cron API 보호용 임의의 긴 문자열. 예(PowerShell): [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
CRON_SECRET=
